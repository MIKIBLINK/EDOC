<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EDOC.Mobile.MainPage" Title="E-DOC Healthcare">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16">
            <Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="E-DOC" FontSize="30" FontAttributes="Bold" TextColor="#155EEF"/><Label Text="Care, connected." TextColor="#526077"/></VerticalStackLayout><Button Grid.Column="1" Text="Emergency" BackgroundColor="#C62828" TextColor="White" CornerRadius="18" Clicked="EmergencyClicked"/></Grid>
            <Border Stroke="#DCE5F1" StrokeShape="RoundRectangle 18" Padding="18"><VerticalStackLayout Spacing="12"><Label Text="Your account" FontSize="20" FontAttributes="Bold"/><Entry x:Name="EmailEntry" Placeholder="Email address" Keyboard="Email"/><Entry x:Name="PasswordEntry" Placeholder="Password (10+ characters)" IsPassword="True"/><Entry x:Name="NameEntry" Placeholder="Your name (for registration)"/><HorizontalStackLayout Spacing="10"><Button Text="Log in" Clicked="LoginClicked"/><Button Text="Create patient account" Clicked="RegisterClicked" BackgroundColor="#E8F2FF" TextColor="#155EEF"/></HorizontalStackLayout><Label x:Name="AuthStatus" Text="Sign in or create an account to continue." TextColor="#526077"/></VerticalStackLayout></Border>
            <Label Text="Find a doctor" FontSize="22" FontAttributes="Bold"/><Grid ColumnDefinitions="*,Auto"><Entry x:Name="SearchEntry" Placeholder="Name or specialty"/><Button Grid.Column="1" Text="Search" Clicked="SearchClicked"/></Grid>
            <CollectionView x:Name="DoctorsList" SelectionMode="Single" SelectionChanged="DoctorSelected"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,4" Padding="14" Stroke="#E2E8F0" StrokeShape="RoundRectangle 14"><Grid ColumnDefinitions="*,Auto"><VerticalStackLayout><Label Text="{Binding Name}" FontAttributes="Bold" FontSize="17"/><Label Text="{Binding Specialty}" TextColor="#526077"/><Label Text="{Binding Qualifications}" FontSize="12"/></VerticalStackLayout><VerticalStackLayout Grid.Column="1" HorizontalOptions="End"><Label Text="{Binding Fee, StringFormat='${0:F2}'}" FontAttributes="Bold"/><Button Text="Slots" CommandParameter="{Binding Id}" Clicked="SlotsClicked"/></VerticalStackLayout></Grid></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
            <Label Text="Appointment availability" FontSize="22" FontAttributes="Bold"/><DatePicker x:Name="AppointmentDate"/><Label x:Name="DoctorChoice" Text="Choose a doctor above" TextColor="#526077"/><Picker x:Name="SlotsPicker" Title="Available times"/><Entry x:Name="ReasonEntry" Placeholder="Reason for visit"/><Button Text="Book appointment" Clicked="BookClicked"/><Label x:Name="BookingStatus" TextColor="#526077"/>
            <Grid ColumnDefinitions="*,Auto"><Label Text="My appointments" FontSize="22" FontAttributes="Bold"/><Button Grid.Column="1" Text="Refresh" Clicked="RefreshAppointmentsClicked"/></Grid><CollectionView x:Name="AppointmentsList" HeightRequest="240"><CollectionView.ItemTemplate><DataTemplate><Border Margin="0,3" Padding="12" Stroke="#E2E8F0" StrokeShape="RoundRectangle 12"><VerticalStackLayout><Label Text="{Binding DoctorName}" FontAttributes="Bold"/><Label Text="{Binding StartsAtUtc, StringFormat='{0:ddd, dd MMM yyyy HH:mm} UTC'}"/><Label Text="{Binding Status}" TextColor="#155EEF"/></VerticalStackLayout></Border></DataTemplate></CollectionView.ItemTemplate></CollectionView>
            <Label Text="Sign in to access your private medical records and appointments. Health information is stored in the configured E-DOC API." FontSize="12" TextColor="#526077"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
